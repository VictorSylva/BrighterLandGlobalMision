# 1. Service ID from EmailJS (Email Services tab -> e.g. service_gmail or service_xxxxxxx)
REACT_APP_EMAILJS_SERVICE_ID=

# 2. Template ID from EmailJS (Email Templates tab -> e.g. template_contact or template_xxxxxxx)
REACT_APP_EMAILJS_TEMPLATE_ID=

# 3. Public Key from EmailJS (Account tab -> API Keys -> Public Key -> e.g. xxxxxxxxxxxxxxxx)
REACT_APP_EMAILJS_PUBLIC_KEY=
